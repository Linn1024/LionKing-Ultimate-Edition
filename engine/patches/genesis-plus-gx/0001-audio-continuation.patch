diff --git a/core/system.c b/core/system.c
index fcdd971..266883a 100644
--- a/core/system.c
+++ b/core/system.c
@@ -56,6 +56,37 @@ static uint8 pause_b;
 static EQSTATE eq[2];
 static int16 llp,rrp;
 
+extern int tlk_blip_state_save(blip_t *, unsigned char *);
+extern int tlk_blip_state_load(blip_t *, const unsigned char *);
+int tlk_audio_state_save(unsigned char *state)
+{
+  int bufferptr = 0, i, present;
+  save_param(eq, sizeof(eq)); save_param(&llp, sizeof(llp)); save_param(&rrp, sizeof(rrp));
+  for (i=0; i<4; i++)
+  {
+    present = snd.blips[i] != 0; save_param(&present, sizeof(present));
+    if (present) bufferptr += tlk_blip_state_save(snd.blips[i], state + bufferptr);
+  }
+  return bufferptr;
+}
+int tlk_audio_state_load(unsigned char *state)
+{
+  int bufferptr = 0, i, present, bytes;
+  load_param(eq, sizeof(eq)); load_param(&llp, sizeof(llp)); load_param(&rrp, sizeof(rrp));
+  for (i=0; i<4; i++)
+  {
+    load_param(&present, sizeof(present));
+    if (present != (snd.blips[i] != 0)) return 0;
+    if (present)
+    {
+      bytes = tlk_blip_state_load(snd.blips[i], state + bufferptr);
+      if (!bytes) return 0;
+      bufferptr += bytes;
+    }
+  }
+  return bufferptr;
+}
