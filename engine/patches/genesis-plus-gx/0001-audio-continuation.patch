@@ -84,6 +84,43 @@ struct blip_t
 #endif
 };
 
+/* TLK checkpoint extension: exclude process-local allocation pointers. The
+ * pinned core ABI is checked by the host before accepting this opaque record. */
+int tlk_blip_state_save(blip_t *m, unsigned char *out)
+{
+  int at = 0;
+  int bytes = (m->size + buf_extra) * sizeof(buf_t);
+#define PUT(v) memcpy(out + at, &(v), sizeof(v)); at += sizeof(v)
+  PUT(m->factor); PUT(m->offset); PUT(m->size); PUT(m->integrator);
+#undef PUT
+#ifdef BLIP_MONO
+  memcpy(out + at, SAMPLES(m), bytes); at += bytes;
+#else
+  memcpy(out + at, m->buffer[0], bytes); at += bytes;
+  memcpy(out + at, m->buffer[1], bytes); at += bytes;
+#endif
+  return at;
+}
+
+int tlk_blip_state_load(blip_t *m, const unsigned char *in)
+{
+  int at = 0, size;
+  int bytes = (m->size + buf_extra) * sizeof(buf_t);
+  /* Reject incompatible allocation sizes before changing this buffer. */
+  memcpy(&size, in + sizeof(m->factor) + sizeof(m->offset), sizeof(size));
+  if (size != m->size) return 0;
+#define GET(v) memcpy(&(v), in + at, sizeof(v)); at += sizeof(v)
+  GET(m->factor); GET(m->offset); GET(size); GET(m->integrator);
+#undef GET
+#ifdef BLIP_MONO
+  memcpy(SAMPLES(m), in + at, bytes); at += bytes;
+#else
+  memcpy(m->buffer[0], in + at, bytes); at += bytes;
+  memcpy(m->buffer[1], in + at, bytes); at += bytes;
+#endif
+  return at;
+}
+
 #ifdef BLIP_MONO
 /* probably not totally portable */
 #define SAMPLES( blip ) ((buf_t*) ((blip) + 1))
diff --git a/core/sound/sound.c b/core/sound/sound.c
index b66d292..a1131d8 100644
--- a/core/sound/sound.c
+++ b/core/sound/sound.c
@@ -59,6 +59,34 @@ static int fm_cycles_start;
 static int fm_cycles_count;
 static int fm_cycles_busy;
 
+/* TLK exact audio continuation, additional to the ordinary chip context. */
+int tlk_sound_state_save(unsigned char *state)
+{
+  int bufferptr = 0, offset = fm_ptr - fm_buffer;
+  save_param(fm_buffer, sizeof(fm_buffer));
+  save_param(fm_last, sizeof(fm_last));
+  save_param(&offset, sizeof(offset));
+  save_param(&fm_cycles_ratio, sizeof(fm_cycles_ratio));
+  save_param(&fm_cycles_start, sizeof(fm_cycles_start));
+  save_param(&fm_cycles_count, sizeof(fm_cycles_count));
+  save_param(&fm_cycles_busy, sizeof(fm_cycles_busy));
+  return bufferptr;
+}
+int tlk_sound_state_load(unsigned char *state)
+{
+  int bufferptr = 0, offset;
+  memcpy(&offset, state + sizeof(fm_buffer) + sizeof(fm_last), sizeof(offset));
+  if (offset < 0 || offset > sizeof(fm_buffer)/sizeof(fm_buffer[0])) return 0;
+  load_param(fm_buffer, sizeof(fm_buffer));
+  load_param(fm_last, sizeof(fm_last));
+  load_param(&offset, sizeof(offset)); fm_ptr = fm_buffer + offset;
+  load_param(&fm_cycles_ratio, sizeof(fm_cycles_ratio));
+  load_param(&fm_cycles_start, sizeof(fm_cycles_start));
+  load_param(&fm_cycles_count, sizeof(fm_cycles_count));
+  load_param(&fm_cycles_busy, sizeof(fm_cycles_busy));
+  return bufferptr;
+}
