# Standalone player graph: build every object/library through current CMake.
include_guard(GLOBAL)
set(_TLK_PLAYER_ENGINE "${CMAKE_CURRENT_LIST_DIR}/..")
include("${CMAKE_CURRENT_LIST_DIR}/TlkPrideHost.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/TlkPrideCore.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/TlkPrideGuest.cmake")

function(tlk_add_pride_player target rom generation md_backend)
    get_filename_component(engine "${_TLK_PLAYER_ENGINE}" ABSOLUTE)
    file(READ "${engine}/player/save-contract.json" contract)
    string(JSON identity GET "${contract}" identity_sha256)
    string(JSON backend_identity GET "${contract}" md_backend_sha256)
    if(NOT CMAKE_SIZEOF_VOID_P EQUAL 4)
        message(FATAL_ERROR "The reviewed Pride save/runtime ABI currently requires a 32-bit build")
    endif()
    file(SHA256 "${md_backend}" actual_backend)
    if(NOT actual_backend STREQUAL backend_identity)
        message(FATAL_ERROR "MD runtime does not match the reviewed player contract")
    endif()
    tlk_add_pride_host_object(${target}_host tlk_sdl "${identity}")
    tlk_add_pride_core_objects(${target}_core tlk_sdl)
    tlk_add_pride_guest_objects(${target}_guest snesrecomp_game "${rom}" "${generation}")
    get_target_property(normal_sources snesrecomp_game SOURCES)
    get_target_property(replacements ${target}_guest SOURCES)
    foreach(replacement IN LISTS replacements)
        get_filename_component(unit "${replacement}" NAME)
        list(FILTER normal_sources EXCLUDE REGEX "/${unit}$")
    endforeach()
    add_library(${target}_native OBJECT ${normal_sources})
    foreach(property INCLUDE_DIRECTORIES COMPILE_DEFINITIONS COMPILE_OPTIONS INTERFACE_COMPILE_DEFINITIONS)
        get_target_property(value snesrecomp_game ${property})
        if(value)
            set_property(TARGET ${target}_native PROPERTY ${property} "${value}")
        endif()
    endforeach()
    # A private generated header avoids relying on a previously generated
    # engine/recomp/funcs.h. The original template remains unchanged.
    target_include_directories(${target}_native BEFORE PRIVATE "${generation}/recomp" "${engine}/runner/pride")
    target_include_directories(${target}_guest BEFORE PRIVATE "${generation}/recomp")
    get_target_property(template_directory tlk_sdl SOURCE_DIR)
    get_target_property(sources tlk_sdl SOURCES)
    set(resolved_sources)
    foreach(source IN LISTS sources)
        if(NOT IS_ABSOLUTE "${source}" AND NOT source MATCHES "^\\$<")
            set(source "${template_directory}/${source}")
        endif()
        list(APPEND resolved_sources "${source}")
    endforeach()
    set(sources ${resolved_sources})
    foreach(unit sdl_main ppu common_rtl interp_bridge tlk_game tlk_savestate tlk_resources
                 tlk_audio tlk_wide tlk_rng_entry tlk_rng_runtime tlk_temp_path)
        list(FILTER sources EXCLUDE REGEX "/${unit}\\.c$")
    endforeach()
    add_executable(${target} ${sources} "${engine}/runner/tlk_native_bank.c" "${engine}/runner/tlk_native_hud.c")
    foreach(property INCLUDE_DIRECTORIES COMPILE_DEFINITIONS COMPILE_OPTIONS LINK_OPTIONS LINK_DIRECTORIES)
        get_target_property(value tlk_sdl ${property})
        if(value)
            set_property(TARGET ${target} PROPERTY ${property} "${value}")
        endif()
    endforeach()
    get_target_property(libraries tlk_sdl LINK_LIBRARIES)
    list(REMOVE_ITEM libraries snesrecomp_game)
    target_link_libraries(${target} PRIVATE ${libraries} ${target}_native)
    get_target_property(template_directory tlk_sdl SOURCE_DIR)
    get_directory_property(directory_definitions DIRECTORY "${template_directory}" COMPILE_DEFINITIONS)
    foreach(part ${target} ${target}_host ${target}_core ${target}_guest ${target}_native)
        target_compile_definitions(${part} PRIVATE ${directory_definitions} SNESRECOMP_HAS_GENERATED_CODE=1 TLK_NATIVE_AUDIO_OWNER_AVAILABLE=1)
    endforeach()
    foreach(part ${target}_host ${target}_core ${target}_guest)
        # Carry the template's transitive SDL/framework include/define usage,
        # while final executable object composition stays explicit below.
        target_link_libraries(${part} PRIVATE ${libraries})
    endforeach()
    target_sources(${target} PRIVATE $<TARGET_OBJECTS:${target}_host>
        $<TARGET_OBJECTS:${target}_core> $<TARGET_OBJECTS:${target}_guest>)
    if(MINGW)
        target_link_options(${target} PRIVATE
            -Wl,--wrap=tlk_state_save,--wrap=tlk_state_load,--wrap=RtlRunFrame,--wrap=TlkResetMachine)
    endif()
    add_custom_command(TARGET ${target} POST_BUILD
        COMMAND ${CMAKE_COMMAND} -E copy_if_different "${md_backend}" "$<TARGET_FILE_DIR:${target}>/genesis_plus_gx_libretro.dll"
        COMMAND ${CMAKE_COMMAND} -E copy_if_different "${engine}/player/save-contract.json" "$<TARGET_FILE_DIR:${target}>/save-contract.json")
endfunction()
