@@ modal-navigation-and-close
<<<<
    if(s_resource_message[0]) { s_resource_message[0]=0;s_resource_page=0;return; }
====
    if(s_resource_message[0]) {
        if(key==SDLK_DOWN || key==SDLK_PAGEDOWN || key==SDLK_RIGHT)ResourceMessageMove(1);
        else if(key==SDLK_UP || key==SDLK_PAGEUP || key==SDLK_LEFT)ResourceMessageMove(-1);
        else if(key==SDLK_F12)ResourceClose(1);
        else { s_resource_message[0]=0;s_resource_page=0; }
        return;
    }
