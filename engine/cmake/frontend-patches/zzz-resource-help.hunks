@@ page-complete-scope-descriptions
<<<<
static void ResourceInfo(void) {
====
/* The modal owns navigation while open; the selected tree node stays put. */
static const char *ResourceMessageNext(const char *text) {
    int n=0;while(text[n] && text[n]!='\n' && n<30)n++;
    text+=n;if(*text=='\n')text++;return text;
}
static int ResourceMessagePages(void) {
    int lines=0;const char *text=s_resource_message;
    while(*text) { lines++;text=ResourceMessageNext(text); }
    return lines?(lines+8)/9:1;
}
static void ResourceMessageMove(int delta) {
    int pages=ResourceMessagePages();s_resource_page+=delta;
    if(s_resource_page<0)s_resource_page=0;
    if(s_resource_page>=pages)s_resource_page=pages-1;
}
static const char *ResourceMessageStart(void) {
    ResourceMessageMove(0);const char *text=s_resource_message;
    for(int i=0;i<s_resource_page*9 && *text;i++)text=ResourceMessageNext(text);
    return text;
}
static void ResourceInfo(void) {
    s_resource_page=0;
