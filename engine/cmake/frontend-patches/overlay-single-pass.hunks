@@ shared-frontend-overlay-drawing
<<<<
/* The widescreen picture into dst (pitch in bytes), with every overlay pixel
 * (where s_screen differs from s_pixels) over its native centre. */
====
/* Draw once against the selected canvas's native-size UI region. */
static void DrawFrontendOverlays(void) {
    if (s_practice && !s_menu_open) DrawPractice();
    DrawToast();
    if (TurboHeld() && !s_menu_open) {
        char t[8];
        snprintf(t, sizeof t, ">>%dx", s_turbo_speed);
        Panel(kWidth - 48, 4, 44, 16);
        Ink(255, 255, 255);
        DrawText(kWidth - 44, 8, t);
    }
    if (s_menu_open && !s_menu_gl)
        recomp_runtime_ui_render_argb8888(s_ui, s_screen, kWidth, kHeight, kWidth * 4);
}

/* Compose the selected picture, then blend overlays against its centre. */
