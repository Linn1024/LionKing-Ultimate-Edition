#include "tlk_porcupine_attack_runtime.h"
static void PorcupineAttackPoint(CpuState *cpu,uint32_t pc) {
    TlkAudioPorcupineAttackVoice(cpu,pc);
    uint32_t next=TlkPorcupineAttackOpcode(cpu,pc);
    if(next)interp_bridge_pre_opcode_redirect(next);
}
static SDL_AudioStream *astream;
