file: sdl_main.c

@@ prime-genuine-pcm-before-device-resume
<<<<
static SDL_AudioStream *astream;
====
static SDL_AudioStream *astream;
static int s_audio_playing;
static void AudioDeviceReset(void) {
    if(astream) {
        SDL_PauseAudioStreamDevice(astream);
        SDL_ClearAudioStream(astream);
    }
    s_audio_playing=0;
}
static void AudioDeviceQueue(const int16_t *pcm, int frames, int target) {
    if(!SDL_PutAudioStreamData(astream,pcm,frames*4))return;
    /* Use the existing ~50 ms target, filled with actual game samples.
     * Opening, loading, pausing and turbo all start a new device queue. */
    if(!s_audio_playing && SDL_GetAudioStreamQueued(astream)>=target*4) {
        if(SDL_ResumeAudioStreamDevice(astream))s_audio_playing=1;
    }
}
