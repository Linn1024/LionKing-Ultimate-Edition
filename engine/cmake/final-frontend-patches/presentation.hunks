    if(!prepare_resources && !ContinueTitleBankAssetsLoad(title_bank_asset_path))return 6;
    if(!prepare_resources && !TlkResourcesTitleAssetsReady()) {
        fprintf(stderr,"Installed caption data is missing or incompatible. Run Setup.\n");return 6;
    }
    if(!prepare_resources && !TlkResourcesCheckpointAssetsReady()) {
        fprintf(stderr,"Installed checkpoint data is missing or incompatible. Run Setup.\n");return 6;
    }
    if(!prepare_resources && !TlkResourcesRevivalAssetsReady()) {
        fprintf(stderr,"Installed revival data is missing or incompatible. Run Setup.\n");return 6;
    }
    if(!prepare_resources && !TlkResourcesNativeHudAssetsReady()) {
        fprintf(stderr,"Installed native HUD data is missing or incompatible. Run Setup.\n");return 6;
    }
