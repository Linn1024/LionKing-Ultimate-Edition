@@ compensate-options-cycles-before-level-select-code
<<<<
    MacroWait(700); MacroTap(DOWN); MacroWait(10); MacroTap(START); MacroWait(80);
====
    MacroWait(700); MacroTap(DOWN); MacroWait(10); MacroTap(START); MacroWait(80);
    /* A fresh boot starts Normal (1). The B,A in the following code cycle
     * Options twice, to Easy (0); Y completes the code before another change.
     * Precede it with ordinary A presses to retain the requested 0/1/2. */
    for(unsigned i=0;i<difficulty;i++) { MacroTap(A); MacroWait(20); }
