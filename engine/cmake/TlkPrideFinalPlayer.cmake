# Separate integration graph; does not change ordinary/public target sources.
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/TlkPridePlayer.cmake")
set(_TLK_FINAL_PLAYER_ENGINE "${CMAKE_CURRENT_LIST_DIR}/..")

function(tlk_add_pride_final_player target rom generation md_backend)
    get_filename_component(engine "${_TLK_FINAL_PLAYER_ENGINE}" ABSOLUTE)
    file(READ "${generation}/generation-report.json" report)
    string(JSON final_hooks ERROR_VARIABLE error GET "${report}" final_scene_hooks)
    if(error OR NOT final_hooks)
        message(FATAL_ERROR "Final-scene player requires --final-scenes hook generation")
    endif()
    file(READ "${generation}/hooks/bankc4_part1d_v2.c" options_hooks)
    foreach(options_pc C4695C C469C2 C46B16 C46B4D)
        string(FIND "${options_hooks}" "PrideSceneCompiledPreOpcode(cpu,0x${options_pc}u)" options_site)
        if(options_site LESS 0)
            message(FATAL_ERROR "Options selection requires regenerated ${options_pc} callback")
        endif()
    endforeach()
    file(READ "${generation}/hooks/bankc3_part07_v2.c" options_value_hooks)
    string(FIND "${options_value_hooks}" "PrideSceneCompiledPreOpcode(cpu,0xC3BE21u)" options_value_site)
    if(options_value_site LESS 0)
        message(FATAL_ERROR "Options values require regenerated C3BE21 callback")
    endif()
    file(READ "${generation}/hooks/bankc1_part18_v2.c" hyena_hooks)
    string(FIND "${hyena_hooks}" "PrideSceneCompiledPreOpcode(cpu,0xC14535u)" hyena_entry)
    if(hyena_entry LESS 0)
        message(FATAL_ERROR "Hyena voice requires regenerated compiled entry C14535")
    endif()
    foreach(battle_site "C14453" "C144D8")
        string(FIND "${hyena_hooks}" "PrideSceneCompiledPreOpcode(cpu,0x${battle_site}u)" battle_jump)
        if(battle_jump LESS 0)
            message(FATAL_ERROR "MD battle music requires generated opening-jump ${battle_site}")
        endif()
    endforeach()
    file(READ "${generation}/hooks/bankc1_part1c_v2.c" lizard_hooks)
    string(FIND "${lizard_hooks}" "PrideSceneCompiledPreOpcode(cpu,0xC1650Eu)" lizard_voice)
    if(lizard_voice LESS 0)
        message(FATAL_ERROR "Lizard voice timing requires regenerated compiled C1650E")
    endif()
    file(READ "${generation}/hooks/bankc0_part17_v2.c" entrance_hooks)
    string(FIND "${entrance_hooks}" "PrideSceneCompiledPreOpcode(cpu,0xC03BDBu)" entrance_window)
    if(entrance_window LESS 0)
        message(FATAL_ERROR "Hyena entrance window requires regenerated compiled C03BDB")
    endif()
    foreach(completion_unit "00" "01")
        file(READ "${generation}/hooks/bankc0_part${completion_unit}_v2.c" completion_hooks)
        string(FIND "${completion_hooks}" "PrideSceneCompiledPreOpcode(cpu,0xC08952u)" completion_entry)
        if(completion_entry LESS 0)
            message(FATAL_ERROR "MD interlevel requires regenerated completion C08952 in unit ${completion_unit}")
        endif()
    endforeach()
    file(READ "${generation}/hooks/bankc0_part07_v2.c" toss_cull_hooks)
    foreach(toss_bound_site "C0BB2F" "C0BB21")
        string(FIND "${toss_cull_hooks}" "aot_pace_point(cpu, _aot_cy, _aot_mc, 0x${toss_bound_site}u)" toss_cull_site)
        if(toss_cull_site LESS 0)
            message(FATAL_ERROR "MD Bug Toss screen bounds require compiled CMP ${toss_bound_site}")
        endif()
    endforeach()
    foreach(exit_unit "00" "01")
        file(READ "${generation}/hooks/bankc0_part${exit_unit}_v2.c" stampede_exit_hooks)
        string(FIND "${stampede_exit_hooks}" "aot_pace_point(cpu, _aot_cy, _aot_mc, 0xC0894Cu)" stampede_exit_site)
        if(stampede_exit_site LESS 0)
            message(FATAL_ERROR "MD Stampede destination requires compiled next-level load C0894C")
        endif()
    endforeach()
    foreach(bonus_unit "17" "18")
        file(READ "${generation}/hooks/bankc5_part${bonus_unit}_v2.c" bonus_hooks)
        if(bonus_unit STREQUAL "17")
            set(bonus_sites "C53BEA" "C53C5A")
        else()
            set(bonus_sites "C542C9" "C54301" "C54827" "C54834")
        endif()
        foreach(bonus_site IN LISTS bonus_sites)
            string(FIND "${bonus_hooks}" "PrideSceneCompiledPreOpcode(cpu,0x${bonus_site}u)" bonus_entry)
            if(bonus_entry LESS 0)
                message(FATAL_ERROR "MD Bug Toss limits require regenerated ${bonus_site}")
            endif()
        endforeach()
    endforeach()
    foreach(toss_reward_kind "hooks" "native")
        file(READ "${generation}/${toss_reward_kind}/bankc5_part19_v2.c" toss_reward_body)
        foreach(toss_reward_pc C5498D C549A9)
            string(FIND "${toss_reward_body}" "aot_pace_point(cpu, _aot_cy, _aot_mc, 0x${toss_reward_pc}u)" toss_reward_site)
            if(toss_reward_site LESS 0)
                message(FATAL_ERROR "MD Toss special eligibility requires compiled ${toss_reward_pc}")
            endif()
        endforeach()
    endforeach()
    foreach(result_unit "00" "01")
        file(READ "${generation}/hooks/bankc0_part${result_unit}_v2.c" result_hooks)
        foreach(result_site "C08866" "C0891D")
            string(FIND "${result_hooks}" "PrideSceneCompiledPreOpcode(cpu,0x${result_site}u)" result_entry)
            if(result_entry LESS 0)
                message(FATAL_ERROR "MD bonus results require regenerated ${result_site} in ${result_unit}")
            endif()
        endforeach()
    endforeach()
    file(READ "${generation}/hooks/bankc5_part17_v2.c" result_hooks)
    string(FIND "${result_hooks}" "PrideSceneCompiledPreOpcode(cpu,0xC53EA0u)" result_entry)
    if(result_entry LESS 0)
        message(FATAL_ERROR "MD result fade requires regenerated C53EA0")
    endif()
    tlk_add_pride_player(${target} "${rom}" "${generation}" "${md_backend}")
    target_compile_definitions(${target}_core PRIVATE TLK_STAMPEDE_EXIT_AVAILABLE=1)
    file(READ "${engine}/runner/aot_pace.h" stampede_shake_bridge)
    string(FIND "${stampede_shake_bridge}" "pc24==0xC088C7u" stampede_shake_dispatch)
    if(stampede_shake_dispatch LESS 0)
        message(FATAL_ERROR "MD Stampede shake requires the ordinary C088C7 callback")
    endif()
    foreach(unit 00 01)
        file(READ "${generation}/hooks/bankc0_part${unit}_v2.c" stampede_shake_body)
        string(FIND "${stampede_shake_body}" "aot_pace_point(cpu, _aot_cy, _aot_mc, 0xC088C7u)" stampede_shake_site)
        if(stampede_shake_site LESS 0)
            message(FATAL_ERROR "MD Stampede shake requires compiled C088C7 in both guest variants")
        endif()
    endforeach()
    target_compile_definitions(${target}_core PRIVATE TLK_STAMPEDE_SHAKE_AVAILABLE=1)
    file(READ "${generation}/native/bankc1_part1d_v2.c" exile_camera_consumers)
    foreach(exile_camera_pc C16A92 C16BDB)
        string(FIND "${exile_camera_consumers}" "aot_pace_point(cpu, _aot_cy, _aot_mc, 0x${exile_camera_pc}u)" exile_camera_site)
        string(FIND "${stampede_shake_bridge}" "pc24==0x${exile_camera_pc}u" exile_camera_dispatch)
        if(exile_camera_site LESS 0 OR exile_camera_dispatch LESS 0)
            message(FATAL_ERROR "MD world-camera consumers require compiled ${exile_camera_pc}")
        endif()
    endforeach()
    file(READ "${generation}/hooks/bankc2_part0d_v2.c" tail_hooks)
    string(FIND "${tail_hooks}" "PrideSceneCompiledPreOpcode(cpu,0xC2EBCEu)" tail_entry)
    if(tail_entry LESS 0)
        message(FATAL_ERROR "MD tail catch requires regenerated C2EBCE")
    endif()
    file(READ "${generation}/hooks/bankc1_part01_v2.c" giraffe_hooks)
    string(FIND "${giraffe_hooks}" "PrideSceneCompiledPreOpcode(cpu,0xC18F74u)" giraffe_entry)
    if(giraffe_entry LESS 0)
        message(FATAL_ERROR "MD giraffe platforms require regenerated C18F74")
    endif()
    foreach(ride_unit "bankc4_part16_v2.c" "bankc0_part07_v2.c")
        file(READ "${generation}/hooks/${ride_unit}" ride_hooks)
        if(ride_unit STREQUAL "bankc4_part16_v2.c")
            set(ride_site "C4326D")
        else()
            set(ride_site "C0BB96")
        endif()
        string(FIND "${ride_hooks}" "PrideSceneCompiledPreOpcode(cpu,0x${ride_site}u)" ride_entry)
        if(ride_entry LESS 0)
            message(FATAL_ERROR "MD ride script requires regenerated ${ride_site}")
        endif()
    endforeach()
    file(READ "${generation}/hooks/bankc4_part17_v2.c" ostrich_hooks)
    string(FIND "${ostrich_hooks}" "PrideSceneCompiledPreOpcode(cpu,0xC439D3u)" ostrich_entry)
    if(ostrich_entry LESS 0)
        message(FATAL_ERROR "MD ostrich obstacles require regenerated C439D3")
    endif()
    foreach(monkey_unit "1a")
        file(READ "${generation}/hooks/bankc4_part${monkey_unit}_v2.c" monkey_hooks)
        foreach(monkey_site "C45687" "C4569C")
            string(FIND "${monkey_hooks}" "PrideSceneCompiledPreOpcode(cpu,0x${monkey_site}u)" monkey_entry)
            if(monkey_entry LESS 0)
                message(FATAL_ERROR "MD monkey roar requires regenerated ${monkey_site} in ${monkey_unit}")
            endif()
        endforeach()
    endforeach()
    foreach(monkey_pair "bankc4_part09_v2.c:C4CDA2" "bankc2_part1a_v2.c:C250CA" "bankc0_part05_v2.c:C0AE3B")
        string(REPLACE ":" ";" monkey_parts "${monkey_pair}")
        list(GET monkey_parts 0 monkey_unit)
        list(GET monkey_parts 1 monkey_site)
        file(READ "${generation}/hooks/${monkey_unit}" monkey_hooks)
        string(FIND "${monkey_hooks}" "PrideSceneCompiledPreOpcode(cpu,0x${monkey_site}u)" monkey_entry)
        if(monkey_entry LESS 0)
            message(FATAL_ERROR "Destiny monkey behavior requires regenerated ${monkey_site}")
        endif()
    endforeach()
    # Both modes delegate these original helpers through the shared bridge.
    file(READ "${engine}/recomp/bankc0.cfg" hyena_probe_cfg)
    foreach(probe_entry "hle_func C5FA TlkTerrainRightDispatch" "hle_func C6DF TlkTerrainLeftDispatch")
        string(FIND "${hyena_probe_cfg}" "${probe_entry}" probe_site)
        if(probe_site LESS 0)
            message(FATAL_ERROR "Hyena walking probe requires original terrain bridge ${probe_entry}")
        endif()
    endforeach()
    set(frontend "${CMAKE_CURRENT_BINARY_DIR}/${target}_host-frontend")
    set(patches "${engine}/cmake/final-frontend-patches")
    file(GLOB hunks CONFIGURE_DEPENDS "${patches}/*.hunks")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${hunks})
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${engine}/scripts/apply_runtime_patches.py"
        --patches "${patches}" --snesrecomp "${frontend}/host" --out "${frontend}/final"
        RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Final-scene frontend patches failed: ${result}")
    endif()
    foreach(editor tlk_resource_editor_sdl.h tlk_resource_editor_selftest.h)
        configure_file("${frontend}/host/${editor}" "${frontend}/final/${editor}" COPYONLY)
    endforeach()
    set_property(TARGET ${target}_host PROPERTY SOURCES "${engine}/runner/pride/final/pride_final_host.c")
    if(MINGW)
        # Optional presentation-only counter, without altering the frozen host.
        target_sources(${target} PRIVATE "${engine}/runner/tlk_visual_resources.cpp"
            "${engine}/runner/tlk_resource_audio_preview.cpp"
            "${engine}/runner/tlk_fps_counter.c"
            "${engine}/runner/tlk_native_render_pace.c"
            "${engine}/runner/tlk_native_update_budget.c")
        target_include_directories(${target} PRIVATE
            "${engine}/recomp-ui/src/third_party/imgui"
            "${engine}/recomp-ui/src/third_party/imgui/backends")
        # Private translation-unit wrapper: original generated body is untouched.
        # Do not force-include this budget shim into other guest programs.
        get_target_property(render_sources ${target}_guest SOURCES)
        set(render_unit "${generation}/hooks/bankc0_part04_v2.c")
        list(FIND render_sources "${render_unit}" render_index)
        if(render_index LESS 0)
            message(FATAL_ERROR "Native sprite assembly requires the original C0 A000-A7FF unit")
        endif()
        set(render_wrapper "${CMAKE_CURRENT_BINARY_DIR}/${target}_native_render.c")
        file(WRITE "${render_wrapper}"
            "#include \"${engine}/runner/tlk_native_render_pace.h\"\n#include \"${render_unit}\"\n")
        list(REMOVE_AT render_sources ${render_index})
        list(APPEND render_sources "${render_wrapper}")
        # The same optional RAM-work budget covers object scheduling, sprite
        # cache scans and the measured enemy update helper. Keep every original
        # instruction/side effect; hardware and explicit waits keep their clocks.
        foreach(work_unit bankc0_part05_v2.c bankc1_part09_v2.c bankc1_part1c_v2.c)
            set(work_source "${generation}/hooks/${work_unit}")
            list(FIND render_sources "${work_source}" work_index)
            if(work_index LESS 0)
                message(FATAL_ERROR "Native world work requires ${work_unit}")
            endif()
            set(work_wrapper "${CMAKE_CURRENT_BINARY_DIR}/${target}_work_${work_unit}")
            file(WRITE "${work_wrapper}"
                "#include \"${engine}/runner/tlk_native_world_pace.h\"\n#include \"${work_source}\"\n")
            list(REMOVE_AT render_sources ${work_index})
            list(APPEND render_sources "${work_wrapper}")
        endforeach()
        set_property(TARGET ${target}_guest PROPERTY SOURCES ${render_sources})
        target_include_directories(${target}_guest PRIVATE "${generation}/hooks")
        get_target_property(attract_sources ${target}_native SOURCES)
        set(attract_unit "${generation}/native/bankc5_part10_v2.c")
        list(FIND attract_sources "${attract_unit}" attract_index)
        if(attract_index LESS 0)
            message(FATAL_ERROR "Installed attract recordings require the original C5 demo unit")
        endif()
        set(attract_wrapper "${CMAKE_CURRENT_BINARY_DIR}/${target}_attract.c")
        file(WRITE "${attract_wrapper}"
            "#include \"${engine}/runner/tlk_attract_pace.h\"\n#include \"${attract_unit}\"\n")
        list(REMOVE_AT attract_sources ${attract_index})
        list(APPEND attract_sources "${attract_wrapper}")
        set_property(TARGET ${target}_native PROPERTY SOURCES ${attract_sources})
        target_include_directories(${target}_native PRIVATE "${generation}/native")
        target_link_options(${target} PRIVATE
            -Wl,--wrap=SDL_RenderPresent,--wrap=SDL_GL_SwapWindow
            -Wl,--wrap=TlkWideEndFrame,--wrap=TlkFallbackEnabled,--wrap=TlkFallbackRecord,--wrap=TlkFallbackSpriteRecord)
        target_link_libraries(${target} PRIVATE shell32)
    endif()
    get_target_property(definitions ${target}_host COMPILE_DEFINITIONS)
    list(FILTER definitions EXCLUDE REGEX "^TLK_PRIDE_FRONTEND_SOURCE=")
    set_property(TARGET ${target}_host PROPERTY COMPILE_DEFINITIONS ${definitions})
    target_compile_definitions(${target}_host PRIVATE
        "TLK_PRIDE_FRONTEND_SOURCE=\"${frontend}/final/sdl_main.c\"")
    get_target_property(sources ${target}_core SOURCES)
    list(FILTER sources EXCLUDE REGEX "/pride_launch_wide\\.c$")
    list(APPEND sources "${engine}/runner/pride/final/pride_final_wide.c")
    set_property(TARGET ${target}_core PROPERTY SOURCES ${sources})
    target_sources(${target} PRIVATE "${engine}/runner/tlk_destiny_monkey.c" "${engine}/runner/tlk_destiny_monkey_data.c"
        "${engine}/runner/tlk_continue_scene.c"
        "${engine}/runner/tlk_final_scene_state.c" "${engine}/runner/tlk_final_art.c"
        "${engine}/runner/tlk_title_opening_art.c" "${engine}/runner/tlk_options_art.c"
        "${engine}/runner/tlk_final_native.c" "${engine}/runner/tlk_title_bank.c"
        "${engine}/runner/tlk_title_navigation.c"
        "${engine}/runner/tlk_pickup_flight_motion.c" "${engine}/runner/tlk_pickup_flight_runtime.c"
        "${engine}/runner/tlk_porcupine_attack.c" "${engine}/runner/tlk_porcupine_attack_runtime.c")
    target_sources(${target} PRIVATE "${engine}/runner/tlk_hyena_probe.c" "${engine}/runner/tlk_hyena_entrance.c")
    # The ordinary C19ACD continuation runs after native animation in both
    # modes. Its installed-data adapter replaces the shake's actual motion.
    file(READ "${generation}/native/bankc1_part03_v2.c" graveyard_shake_body)
    file(READ "${engine}/runner/aot_pace.h" graveyard_shake_bridge)
    string(FIND "${graveyard_shake_body}" "aot_pace_point(cpu, _aot_cy, _aot_mc, 0xC19ACDu)" graveyard_shake_site)
    string(FIND "${graveyard_shake_bridge}" "pc24==0xC19ACDu" graveyard_shake_dispatch)
    if(graveyard_shake_site LESS 0 OR graveyard_shake_dispatch LESS 0)
        message(FATAL_ERROR "MD falling-bone motion requires the ordinary C19ACD callback")
    endif()
    string(REGEX MATCHALL "aot_pace_point\\(cpu, _aot_cy, _aot_mc, 0xC19AEEu\\)" graveyard_drop_sites "${graveyard_shake_body}")
    list(LENGTH graveyard_drop_sites graveyard_drop_site_count)
    string(FIND "${graveyard_shake_bridge}" "pc24==0xC19AEEu" graveyard_drop_dispatch)
    if(NOT graveyard_drop_site_count EQUAL 1 OR graveyard_drop_dispatch LESS 0)
        message(FATAL_ERROR "MD falling-bone retry requires the native C19AEE callback")
    endif()
    file(READ "${generation}/native/bankc0_part0b_v2.c" graveyard_head_surface_body)
    string(REGEX MATCHALL "aot_pace_point\\(cpu, _aot_cy, _aot_mc, 0xC0D8B2u\\)" graveyard_head_sites "${graveyard_head_surface_body}")
    list(LENGTH graveyard_head_sites graveyard_head_site_count)
    string(FIND "${graveyard_shake_bridge}" "pc24==0xC0D8B2u" graveyard_head_dispatch)
    if(NOT graveyard_head_site_count EQUAL 1 OR graveyard_head_dispatch LESS 0)
        message(FATAL_ERROR "MD falling-bone surfaces require the native C0D8B2 callback")
    endif()
    target_compile_definitions(${target}_core PRIVATE TLK_GRAVEYARD_SHAKE_AVAILABLE=1)
    file(READ "${generation}/native/bankc1_part1e_v2.c" graveyard_flight_body)
    foreach(graveyard_turn_pc C175CD C17635)
        string(FIND "${graveyard_flight_body}" "aot_pace_point(cpu, _aot_cy, _aot_mc, 0x${graveyard_turn_pc}u)" graveyard_turn_site)
        string(FIND "${graveyard_shake_bridge}" "pc24==0x${graveyard_turn_pc}u" graveyard_turn_dispatch)
        if(graveyard_turn_site LESS 0 OR graveyard_turn_dispatch LESS 0)
            message(FATAL_ERROR "MD vulture turns require native ${graveyard_turn_pc} callback")
        endif()
    endforeach()
    target_compile_definitions(${target}_core PRIVATE TLK_GRAVEYARD_TURN_AVAILABLE=1)
    string(FIND "${graveyard_flight_body}" "aot_pace_point(cpu, _aot_cy, _aot_mc, 0xC17155u)" graveyard_launch_site)
    string(FIND "${graveyard_shake_bridge}" "pc24==0xC17155u" graveyard_launch_dispatch)
    if(graveyard_launch_site LESS 0 OR graveyard_launch_dispatch LESS 0)
        message(FATAL_ERROR "MD launching-vulture parity requires native C17155 callback")
    endif()
    target_compile_definitions(${target}_core PRIVATE TLK_GRAVEYARD_LAUNCH_AVAILABLE=1)
    file(READ "${generation}/hooks/bankc0_part05_v2.c" graveyard_farewell_parser)
    foreach(graveyard_farewell_pc C0AD4E C0AD58 C0AD62 C0ADD0 C0ADD5 C0AE39)
        string(FIND "${graveyard_farewell_parser}" "aot_pace_point(cpu, _aot_cy, _aot_mc, 0x${graveyard_farewell_pc}u)" graveyard_farewell_site)
        string(FIND "${graveyard_shake_bridge}" "pc24==0x${graveyard_farewell_pc}u" graveyard_farewell_dispatch)
        if(graveyard_farewell_site LESS 0 OR graveyard_farewell_dispatch LESS 0)
            message(FATAL_ERROR "MD Mufasa farewell requires native ${graveyard_farewell_pc} parser callback")
        endif()
    endforeach()
    target_compile_definitions(${target}_core PRIVATE TLK_GRAVEYARD_FAREWELL_AVAILABLE=1)
    # Pickup selection reuses the maintained ordinary marker-registration and
    # checkpoint callbacks already used by Return and Pride Rock.
    file(READ "${generation}/rng/bankc0_part06_v2.c" graveyard_pickup_registration)
    file(READ "${generation}/native/bankc0_part00_v2.c" graveyard_pickup_retry)
    string(FIND "${graveyard_pickup_registration}" "0xC0B7DFu" graveyard_pickup_entry_site)
    string(FIND "${graveyard_pickup_retry}" "0xC08560u" graveyard_pickup_retry_site)
    if(graveyard_pickup_entry_site LESS 0 OR graveyard_pickup_retry_site LESS 0)
        message(FATAL_ERROR "MD Graveyard pickups require ordinary entry and checkpoint marker callbacks")
    endif()
    target_compile_definitions(${target}_core PRIVATE TLK_GRAVEYARD_PICKUPS_AVAILABLE=1)
    # Both compiled variants forward these shared helpers to the interpreter
    # bridge. The same pre-store coordinate seam therefore serves both modes.
    file(READ "${generation}/native/bankc0_part08_v2.c" graveyard_wall_wrappers)
    file(READ "${engine}/runner/tlk_terrain.c" graveyard_wall_dispatch)
    foreach(direction "Left" "Right")
        string(REGEX MATCHALL "_r = TlkTerrain${direction}Dispatch\\(cpu\\)" graveyard_wall_calls "${graveyard_wall_wrappers}")
        list(LENGTH graveyard_wall_calls graveyard_wall_count)
        if(NOT graveyard_wall_count EQUAL 4)
            message(FATAL_ERROR "MD hyena wall query requires all four delegated ${direction} helper variants")
        endif()
    endforeach()
    foreach(entry "c5fa" "c6df")
        string(FIND "${graveyard_wall_dispatch}" "TlkRunOriginal(cpu,0x${entry},2)" graveyard_wall_delegate)
        if(graveyard_wall_delegate LESS 0)
            message(FATAL_ERROR "MD hyena wall query requires the maintained original helper bridge")
        endif()
    endforeach()
    target_compile_definitions(${target}_core PRIVATE TLK_GRAVEYARD_WALL_AVAILABLE=1)

    # Base player configuration has already validated the recorded native and
    # guest callback units and their source manifest. Older generations keep
    # this capability unavailable instead of claiming a compiled renderer/AI.
    file(READ "${generation}/generation-report.json" native_report)
    string(JSON native_hook_type ERROR_VARIABLE native_hook_error TYPE "${native_report}" native_hooks)
    if(native_hook_type STREQUAL "OBJECT")
        target_compile_definitions(${target}_core PRIVATE TLK_BE_PREPARED_BEHAVIOR_AVAILABLE=1 TLK_BE_PREPARED_GROUP_AUDIO_AVAILABLE=1)
    endif()
    target_sources(${target} PRIVATE "${engine}/runner/tlk_graveyard_gameplay.c" "${engine}/runner/tlk_graveyard_data.c" "${engine}/runner/tlk_next_scene_data.c" "${engine}/runner/tlk_late_scene_data.c" "${engine}/runner/tlk_be_prepared_data.c" "${engine}/runner/tlk_be_prepared_gameplay.c" "${engine}/runner/tlk_be_prepared_behavior.c" "${engine}/runner/tlk_scar_contact.c" "${engine}/runner/tlk_adult_ledge.c" "${engine}/runner/tlk_adult_hyena.c" "${engine}/runner/tlk_return_hyenas.c" "${engine}/runner/tlk_return_door.c" "${engine}/runner/tlk_return_exit.c" "${engine}/runner/tlk_scar_activation.c" "${engine}/runner/tlk_interlevel_data.c" "${engine}/runner/tlk_interlevel_scene.c" "${engine}/runner/tlk_bonus_result_data.c" "${engine}/runner/tlk_bonus_result_scene.c" "${engine}/runner/tlk_cant_wait_data.c" "${engine}/runner/tlk_cant_wait_gameplay.c")
    target_compile_definitions(${target}_core PRIVATE TLK_PRIDE_FINAL_AVAILABLE=1 TLK_HYENA_VOICE_ENTRY_AVAILABLE=1 TLK_LIZARD_VOICE_TIMING_AVAILABLE=1 TLK_HYENA_PROBE_AVAILABLE=1 TLK_HYENA_ENTRANCE_AVAILABLE=1 TLK_FINAL_MENU_ART_AVAILABLE=1)
    target_compile_definitions(${target}_core PRIVATE TLK_BATTLE_MUSIC_TRIGGER_AVAILABLE=1 TLK_INTERLEVEL_AVAILABLE=1)
    target_compile_definitions(${target}_core PRIVATE TLK_BONUS_ARENA_AVAILABLE=1 TLK_BONUS_CULL_AVAILABLE=1 TLK_BONUS_RESULT_AVAILABLE=1 TLK_BONUS_TOSS_REWARDS_AVAILABLE=1)
    target_sources(${target} PRIVATE "${engine}/runner/tlk_cw_terrain.c" "${engine}/runner/tlk_cw_terrain_data.c" "${engine}/runner/tlk_hunt_data.c")
    target_compile_definitions(${target}_core PRIVATE TLK_CANT_WAIT_TAIL_AVAILABLE=1 TLK_CANT_WAIT_ROAR_AVAILABLE=1 TLK_CANT_WAIT_GIRAFFE_AVAILABLE=1 TLK_CANT_WAIT_OSTRICH_AVAILABLE=1 TLK_CANT_WAIT_TERRAIN_AVAILABLE=1 TLK_CANT_WAIT_HIPPO_AVAILABLE=1 TLK_CANT_WAIT_RHINO_AVAILABLE=1 TLK_GRAVEYARD_INPUT_DELAY_AVAILABLE=1 TLK_GRAVEYARD_REVEAL_MARKER_AVAILABLE=1 TLK_GRAVEYARD_CONTROL_HANDOFF_AVAILABLE=1 TLK_GRAVEYARD_INPUT_FILTER_AVAILABLE=1 TLK_GRAVEYARD_BONE_MARKERS_AVAILABLE=1 TLK_GRAVEYARD_VULTURE_MARKERS_AVAILABLE=1 TLK_LATE_ENTRY_AVAILABLE=1 TLK_STAMPEDE_RULES_AVAILABLE=1 TLK_EXILE_GRIP_AVAILABLE=1 TLK_EXILE_TERRAIN_AVAILABLE=1 TLK_HAKUNA_TERRAIN_AVAILABLE=1 TLK_HAKUNA_RETRY_AVAILABLE=1 TLK_HAKUNA_SPIDERS_AVAILABLE=1 TLK_HAKUNA_FROGS_AVAILABLE=1 TLK_HAKUNA_INITIALIZATION_AVAILABLE=1 TLK_HAKUNA_POISON_AVAILABLE=1 TLK_HAKUNA_CHECKPOINT_AVAILABLE=1 TLK_HAKUNA_FATAL_AVAILABLE=1
    TLK_HAKUNA_LOGS_AVAILABLE=1 TLK_HAKUNA_LIFE_AVAILABLE=1
    TLK_HAKUNA_ARENA_AVAILABLE=1 TLK_HAKUNA_BONUS_AVAILABLE=1 TLK_DESTINY_BOULDER_AVAILABLE=1 TLK_DESTINY_TERRAIN_AVAILABLE=1 TLK_DESTINY_OBSTACLES_AVAILABLE=1 TLK_ADULT_POINTS_AVAILABLE=1 TLK_ADULT_TURN_AVAILABLE=1 TLK_DESTINY_ROCK_POSITIONS_AVAILABLE=1 TLK_DESTINY_ROCK_SURFACE_AVAILABLE=1 TLK_DESTINY_ARENA_AVAILABLE=1 TLK_ADULT_ROAR_AVAILABLE=1 TLK_DESTINY_MONKEY_AVAILABLE=1 TLK_DESTINY_EXIT_AVAILABLE=1 TLK_BONUS_SELECTION_AVAILABLE=1 TLK_BE_PREPARED_ROCKS_AVAILABLE=1 TLK_BE_PREPARED_TERRAIN_AVAILABLE=1 TLK_BE_PREPARED_RETRY_AVAILABLE=1 TLK_LATE_LAYOUT_AVAILABLE=1 TLK_SCAR_CONTACT_RESPONSE_AVAILABLE=1 TLK_ADULT_LEDGE_REACTIONS_AVAILABLE=1 TLK_ADULT_HYENA_CULLING_AVAILABLE=1 TLK_RETURN_DOORWAY_HYENAS_AVAILABLE=1 TLK_RETURN_DOOR_TIMING_AVAILABLE=1 TLK_RETURN_WALL_AVAILABLE=1 TLK_RETURN_EXIT_AVAILABLE=1 TLK_SCAR_ACTIVATION_AVAILABLE=1 TLK_BE_PREPARED_AVAILABLE=1
    TLK_HAKUNA_LOG_CONTINUITY_AVAILABLE=1 TLK_EXILE_EXIT_AVAILABLE=1 TLK_GRAVEYARD_BONE_CONTACT_AVAILABLE=1 TLK_GRAVEYARD_ENTRY_AVAILABLE=1 TLK_CANT_WAIT_EXIT_AVAILABLE=1 TLK_CANT_WAIT_GRIP_AVAILABLE=1 TLK_BONUS_HUNT_AVAILABLE=1 TLK_HUNT_MOTION_AVAILABLE=1)
    target_compile_definitions(${target}_core PRIVATE TLK_PORCUPINE_VOICE_TIMING_AVAILABLE=1)
    # The common 1UP rule needs both its actor and real award instruction seams.
    foreach(life_unit "native/bankc5_part1a_v2.c" "hooks/bankc0_part1e_v2.c" "hooks/bankc0_part10_v2.c")
        file(READ "${generation}/${life_unit}" life_body)
        if(life_unit MATCHES "bankc5")
            set(life_sites C556D7 C556E7)
        elseif(life_unit MATCHES "part10")
            set(life_sites C001D4)
        else()
            set(life_sites C075D4 C075D9)
        endif()
        foreach(life_pc IN LISTS life_sites)
            string(FIND "${life_body}" "aot_pace_point(cpu, _aot_cy, _aot_mc, 0x${life_pc}u)" life_site)
            if(life_site LESS 0)
                message(FATAL_ERROR "MD 1UP availability requires compiled ${life_pc}")
            endif()
        endforeach()
    endforeach()
    target_compile_definitions(${target}_core PRIVATE TLK_LIFE_PICKUP_AVAILABLE=1)
    get_target_property(final_sources ${target} SOURCES)
    list(FILTER final_sources EXCLUDE REGEX "/tlk_md_hud\\.c$")
    list(FILTER final_sources EXCLUDE REGEX "/tlk_md_sprites\\.c$")
    set_property(TARGET ${target} PROPERTY SOURCES ${final_sources})
    target_sources(${target} PRIVATE "${engine}/runner/tlk_md_hud_assets.c"
        "${CMAKE_CURRENT_BINARY_DIR}/${target}_core-sources/game/tlk_md_hud.c"
        "${CMAKE_CURRENT_BINARY_DIR}/${target}_core-sources/game/tlk_md_sprites.c")
endfunction()
